rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection group rule for passes - allows querying all passes subcollections
    match /{path=**}/passes/{passId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Tournament rules - PUBLIC READ ACCESS
    match /tournaments/{tournamentId} {
      // Allow public read access for tournaments (for home page and TV display)
      allow read: if true;
      
      // Allow creating tournaments if user is authenticated and is the creator
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.createdBy &&
                   isValidTournamentData(request.resource.data);
      
      // Allow updating only by the tournament creator with valid data
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.createdBy &&
                   isValidTournamentData(request.resource.data);
      
      // Allow deleting only by the tournament creator (no data validation needed for delete)
      allow delete: if request.auth != null &&
                   request.auth.uid == resource.data.createdBy;
    }
    
    // Players collection rules - TEMPORARILY RELAXED FOR DEBUGGING
    match /players/{playerId} {
      // Allow public read access for players (needed for umpire scoring and TV displays)
      allow read: if true;
      
      // ALLOW ANYONE TO CREATE PLAYERS - NO VALIDATION (needed for CCPL custom auth users)
      allow create: if true;
      
      // Allow updating by the player creator OR by super admin OR by tournament creator OR for any unauthenticated update
      allow update: if request.auth == null ||
                   (request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple() ||
                    isTournamentCreator(resource.data.tournamentId)) &&
                   (isSuperAdminSimple() || isValidPlayerUpdateData(request.resource.data)));
      
      // Allow deleting only by the player creator (no data validation needed for delete)
      allow delete: if request.auth != null &&
                   request.auth.uid == resource.data.createdBy;
    }
    
    // Teams collection rules
    match /teams/{teamId} {
      // Allow public read access for teams (for umpire scoring, streaming overlay and TV display)
      allow read: if true;
      
      // Allow creating teams if user is authenticated
      allow create: if request.auth != null;
      
      // Allow updating by the team creator OR by super admin OR for specific field updates (for migration/CCPL users)
      allow update: if request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple()) ||
                   // Allow unauthenticated updates for venueId field only (for migration)
                   (request.resource.data.keys().hasOnly(resource.data.keys().concat(['venueId'])) &&
                    request.resource.data.venueId is string) ||
                   // Allow unauthenticated updates for playerIds and updatedAt (for CCPL custom auth users)
                   (request.resource.data.keys().hasOnly(resource.data.keys().concat(['playerIds', 'updatedAt'])));
      
      // Allow deleting only by the team creator (no data validation needed for delete)
      allow delete: if request.auth != null &&
                   request.auth.uid == resource.data.createdBy;
    }
    
    // Fixtures collection rules - PUBLIC READ AND WRITE ACCESS
    match /fixtures/{fixtureId} {
      // Allow public read access for streaming venues and displays
      allow read: if true;
      // Allow public write access for umpire scoring (unauthenticated users can update match scores)
      allow write: if true;
    }
    
    // Fixture Groups collection rules - COMPLETELY OPEN FOR TESTING
    match /fixtureGroups/{fixtureGroupId} {
      // Allow all operations for testing
      allow read, write: if true;
    }
    
    // Matches collection rules - PUBLIC READ ACCESS
    match /matches/{matchId} {
      // Allow public read access for streaming overlays and displays
      allow read: if true;
      // Allow write only for authenticated users
      allow write: if request.auth != null;
    }
    
    // Users collection rules - Enhanced for super admin management
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Super admins can read all user documents
      allow read, list: if request.auth != null && isSuperAdminSimple();
      
      // Super admins can create new user documents with valid data
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidUserData(request.resource.data);
      
      // Super admins can update user documents with valid data
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidUserData(request.resource.data);
      
      // Super admins can delete user documents (except their own)
      allow delete: if request.auth != null &&
                   isSuperAdminSimple() &&
                   request.auth.uid != userId;
    }
    
    // Venues collection rules
    match /venues/{venueId} {
      // Allow public read access for venues (needed for fixture display)
      allow read: if true;
      
      // Only super admins can create, update, or delete venues
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidVenueData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidVenueData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Featured Videos collection rules
    match /featuredVideos/{videoId} {
      // Allow public read access for featured videos (needed for home page)
      allow read: if true;
      
      // Only super admins can create, update, or delete featured videos
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidFeaturedVideoData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidFeaturedVideoData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // News collection rules
    match /news/{newsId} {
      // Allow public read access for news (needed for home page)
      allow read: if true;
      
      // Only super admins can create, update, or delete news
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidNewsData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidNewsData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Display Settings collection rules
    match /display_settings/{settingId} {
      // Allow public read access for display settings (needed for main display)
      allow read: if true;
      
      // Only super admins can create, update, or delete display settings
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidDisplaySettingData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidDisplaySettingData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Overlay Controls collection rules - for streaming overlay player cards
    match /overlay_controls/{controlId} {
      // Allow public read and write access for overlay controls (needed for streaming functionality)
      allow read, write: if true;
    }
    
    // Video Links collection rules - for ads videos management
    match /video_links/{tournamentId} {
      // Allow public read access for video links (needed for display)
      allow read: if true;
      
      // Only super admins can create, update, or delete video links
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidVideoLinksData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidVideoLinksData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Tournament Logos collection rules - for logo management
    match /tournament_logos/{tournamentId} {
      // Allow public read access for tournament logos (needed for display)
      allow read: if true;
      
      // Only super admins can create, update, or delete tournament logos
      allow create: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidTournamentLogosData(request.resource.data);
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple() &&
                   isValidTournamentLogosData(request.resource.data);
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Clubs Players collection rules - for HPL player registration
    match /clubs-players/{playerId} {
      // Allow public read and write access for player registration form
      allow read, write: if true;
    }
    
    // HPL Clubs collection rules - for HPL club registration
    match /hpl-clubs/{clubId} {
      // Allow public read access for club registration form
      allow read: if true;
      
      // Allow creating clubs with valid data structure
      // Less strict validation for initial creation
      allow create: if true;
      
      // Allow updating clubs with less strict validation for partial updates
      // This is more permissive to allow for updates to owner images and names
      allow update: if true;
      
      // Allow deleting clubs (for admin purposes)
      allow delete: if true;
    }
    
    // HPL Club Players collection rules - for HPL club player management
    match /hpl-club-players/{playerId} {
      // Allow public read access for club players (needed for tournament auto-load)
      allow read: if true;
      
      // Allow creating club players with valid data
      allow create: if true;
      
      // Allow updating club players
      allow update: if true;
      
      // Allow deleting club players
      allow delete: if true;
    }
    
    // Email OTPs collection rules - for email verification
    match /email-otps/{otpId} {
      // Allow public read access for OTP verification (needed for email verification)
      allow read: if true;
      
      // Only Firebase Functions can create OTPs
      allow create: if false;
      
      // No updates or deletes allowed from frontend
      allow update, delete: if false;
    }
    
    // Recruitment Requests collection rules - for club player recruitment
    match /recruitment-requests/{requestId} {
      // Allow public read and write access for recruitment functionality
      allow read, write: if true;
    }
    
    // Player Interests collection rules - for player to express interest in clubs
    match /player-interests/{interestId} {
      // Allow public read and write access for player interest functionality
      allow read, write: if true;
    }
    
    // Password reset tokens collection rules
    match /password-reset-tokens/{tokenId} {
      // Allow public read and write access for password reset functionality
      allow read, write: if true;
    }
    
    // Clutch Analytics collection rules - for player matchmaking data from Clutch Sports
    match /clutch-analytics/{fixtureId} {
      // Allow public read access for clutch analytics data
      allow read: if true;
      
      // Allow authenticated users to create and update clutch analytics data
      allow create, update: if request.auth != null;
      
      // Allow deleting only by authenticated users
      allow delete: if request.auth != null;
    }
    
    // Draft Settings collection rules - for draft configuration
    match /draftSettings/{settingId} {
      // Allow public read access for draft settings (needed for draft displays)
      allow read: if true;
      
      // Only super admins can create, update, or delete draft settings
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Draft Teams collection rules - for draft team management
    match /draftTeams/{teamId} {
      // Allow public read access for draft teams (needed for draft displays)
      allow read: if true;
      
      // Allow authenticated users to create draft teams
      allow create: if request.auth != null;
      
      // Allow updating by team creator or super admin
      allow update: if request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple());
      
      // Allow deleting by team creator or super admin
      allow delete: if request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple());
    }
    
    // Draft Players collection rules - for draft player management
    match /draftPlayers/{playerId} {
      // Allow public read access for draft players (needed for draft displays)
      allow read: if true;
      
      // Allow authenticated users to create draft players
      allow create: if request.auth != null;
      
      // Allow updating by player creator or super admin
      allow update: if request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple());
      
      // Allow deleting by player creator or super admin
      allow delete: if request.auth != null &&
                   (request.auth.uid == resource.data.createdBy ||
                    isSuperAdminSimple());
    }
    
    // Draft State collection rules - for live draft state management
    match /draftState/{stateId} {
      // Allow public read access for draft state (needed for live displays)
      allow read: if true;
      
      // Allow authenticated users to update draft state
      allow update: if request.auth != null;
      
      // Only super admins can create or delete draft state
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Team Sessions collection rules - for team login sessions during draft
    match /teamSessions/{sessionId} {
      // Allow public read and write access for team sessions (needed for team draft room login)
      allow read, write: if true;
    }
    
    // Captain Settings collection rules - for captain assignment configuration
    match /captainSettings/{settingId} {
      // Allow public read access for captain settings (needed for draft displays)
      allow read: if true;
      
      // Only super admins can create, update, or delete captain settings
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Owner Player Settings collection rules - for owner player assignment configuration
    match /ownerPlayerSettings/{settingId} {
      // Allow public read access for owner player settings (needed for draft displays)
      allow read: if true;
      
      // Only super admins can create, update, or delete owner player settings
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Clubs Ads collection rules - for advertisement videos management
    match /clubs-ads/{adId} {
      // Allow public read and write access for ads management
      allow read, write: if true;
    }
    
    // Products collection rules - for Shop management
    match /products/{productId} {
      // Allow public read access for products (needed for shop display)
      allow read: if true;
      
      // Only super admins can create, update, or delete products
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // App Settings collection rules - for mobile app configuration
    match /app-settings/{settingId} {
      // Allow public read access for app settings (needed for mobile app)
      allow read: if true;
      
      // Only super admins can create, update, or delete app settings
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // HPL Users collection rules - for custom user management
    // WARNING: This stores passwords directly - use Firebase Auth in production
    match /hpl-users/{userId} {
      // Allow public read access (excluding password field in queries)
      allow read: if true;
      
      // Allow anyone to create a user account (for registration)
      allow create: if request.resource.data.keys().hasAll(['email', 'password', 'phone_number', 'photo_url']) &&
                   request.resource.data.email is string &&
                   request.resource.data.password is string &&
                   request.resource.data.phone_number is string &&
                   request.resource.data.photo_url is string;
      
      // Allow users to update their own data or super admins to update any user
      allow update: if request.auth != null &&
                   (request.auth.token.email == resource.data.email ||
                    isSuperAdminSimple());
      
      // Only super admins can delete users
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Fantasy Teams - for user fantasy teams
    // Structure includes gameweeks for player selections per gameweek:
    // gameweeks: {
    //   [gameweekNumber]: {
    //     playerIds: string[];
    //     points: number;
    //     locked: boolean;
    //   }
    // }
    match /fantasy-teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    // Fantasy Players - for player stats per tournament
    match /fantasy-players/{tournamentId}/players/{playerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isSuperAdminSimple();
    }
    
    // Ticketing collection rules - for ticket and pass management
    match /ticketing/{ticketId} {
      // Allow public read access for tickets (needed for mobile app shop)
      allow read: if true;
      
      // Only super admins can create, update, or delete tickets
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow update: if request.auth != null &&
                   isSuperAdminSimple();
      
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
      
      // Ticket Types subcollection
      match /ticketTypes/{typeId} {
        // Allow public read access for ticket types
        allow read: if true;
        
        // Only super admins can create, update, or delete ticket types
        allow create: if request.auth != null &&
                     isSuperAdminSimple();
        
        allow update: if request.auth != null &&
                     isSuperAdminSimple();
        
        allow delete: if request.auth != null &&
                     isSuperAdminSimple();
      }
      
      // Passes subcollection - for pass requests
      match /passes/{passId} {
        // Allow public read access for passes (users can see their own requests)
        allow read: if true;
        
        // Allow anyone to create a pass request
        allow create: if true;
        
        // Allow authenticated users to update pass status (for team admins to approve/decline)
        allow update: if true;
        
        // Allow authenticated users to delete passes
        allow delete: if true;
      }
      
      // Allocation subcollection - for team pass allocations
      match /allocation/{teamId} {
        // Allow public read access for allocations
        allow read: if true;
        
        // Allow authenticated users to create and update allocations
        allow create, update: if true;
        
        // Allow authenticated users to delete allocations
        allow delete: if true;
      }
      
      // Orders subcollection rules (for future ticket purchases)
      match /orders/{orderId} {
        // Allow public read access for orders
        allow read: if true;
        
        // Allow authenticated users to create orders
        allow create: if request.auth != null;
        
        // Only super admins or order creator can update orders
        allow update: if request.auth != null &&
                     (isSuperAdminSimple() ||
                      request.auth.uid == resource.data.userId);
        
        // Only super admins can delete orders
        allow delete: if request.auth != null &&
                     isSuperAdminSimple();
        
        // Tickets subcollection rules (individual tickets with QR codes)
        match /tickets/{ticketId} {
          // Allow public read access for tickets
          allow read: if true;
          
          // Allow authenticated users to create tickets
          allow create: if request.auth != null;
          
          // Only super admins can update tickets (e.g., mark as used)
          allow update: if request.auth != null &&
                       isSuperAdminSimple();
          
          // Only super admins can delete tickets
          allow delete: if request.auth != null &&
                       isSuperAdminSimple();
        }
      }
    }
    
    // Vendors collection rules - for vendor management
    match /vendors/{vendorId} {
      // Allow public read access for vendors (needed for vendor portal)
      allow read: if true;
      
      // Only super admins can create vendors
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      // Super admins can update vendors, or vendors can update their own data
      allow update: if request.auth != null &&
                   (isSuperAdminSimple() ||
                    request.auth.token.email == resource.data.email);
      
      // Only super admins can delete vendors
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Vendor Setup Tokens collection rules - for password setup
    match /vendor-setup-tokens/{tokenId} {
      // Allow public read access for token verification
      allow read: if true;
      
      // Only super admins and the vendor service can create tokens
      allow create: if request.auth != null &&
                   isSuperAdminSimple();
      
      // Allow updates to mark tokens as used (public access for password setup)
      allow update: if true;
      
      // Only super admins can delete tokens
      allow delete: if request.auth != null &&
                   isSuperAdminSimple();
    }
    
    // Vendor Items collection rules - for menu item management
    match /vendor-items/{itemId} {
      // Allow public read access for menu items (for order placement)
      allow read: if true;
      
      // Allow anyone to create menu items (vendors use custom auth, not Firebase Auth)
      allow create: if true;
      
      // Allow anyone to update menu items (vendors use custom auth, not Firebase Auth)
      allow update: if true;
      
      // Allow anyone to delete menu items (vendors use custom auth, not Firebase Auth)
      allow delete: if true;
    }
    
    // Vendor Orders collection rules - for order management
    match /vendor-orders/{orderId} {
      // Allow public read access for orders (vendors use custom auth)
      allow read: if true;
      
      // Allow anyone to create orders (vendors use custom auth, not Firebase Auth)
      allow create: if true;
      
      // Allow anyone to update orders (vendors use custom auth, not Firebase Auth)
      allow update: if true;
      
      // Allow anyone to delete orders (vendors use custom auth, not Firebase Auth)
      allow delete: if true;
    }
    
    // Merch Orders collection rules - for merchandise order management
    match /merch-orders/{orderId} {
      // Allow public read access for orders
      allow read: if true;
      
      // Allow anyone to create orders (for mobile app purchases)
      allow create: if true;
      
      // Allow anyone to update orders (for order status updates)
      allow update: if true;
      
      // Allow anyone to delete orders (for order management)
      allow delete: if true;
    }
    
    // CCPL Users collection rules - for mobile app user management
    match /ccpl-users/{userId} {
      // Allow public read and write access for user management
      // Since we're not using Firebase Auth, allow all operations
      allow read, write: if true;
      
      // Registration subcollection - for CCPL player registration data
      match /registration/{registrationId} {
        // Allow public read and write access for registration
        allow read, write: if true;
      }
    }
    
    // Function to validate clubs player data structure
    function isValidClubsPlayerData(data) {
      return data.keys().hasAll(['fullName', 'mobileNumber', 'emailId', 'password', 'gender', 'dateOfBirth', 'singlesRating', 'doublesRating', 'singlesReliabilityScore', 'doublesReliabilityScore', 'whyPickYou', 'leagueCommitment', 'registrationFee']) &&
             data.fullName is string &&
             data.mobileNumber is string &&
             data.emailId is string &&
             data.password is string &&
             data.gender is string &&
             data.gender in ['male', 'female'] &&
             data.dateOfBirth is string &&
             data.singlesRating is string &&
             data.doublesRating is string &&
             data.singlesReliabilityScore is string &&
             data.doublesReliabilityScore is string &&
             data.whyPickYou is string &&
             data.leagueCommitment is bool &&
             data.registrationFee is bool &&
             // Optional fields
             (data.duprId == null || data.duprId is string) &&
             (data.dilemma1 == null || data.dilemma1 is string) &&
             (data.dilemma2 == null || data.dilemma2 is string) &&
             (data.dilemma3 == null || data.dilemma3 is string) &&
             // Cloudinary photo fields
             (data.photoUrl == null || data.photoUrl is string) &&
             (data.photoPublicId == null || data.photoPublicId is string) &&
             (data.photoFileName == null || data.photoFileName is string) &&
             (data.photoFileSize == null || data.photoFileSize is number) &&
             // Cloudinary Aadhar document fields
             (data.aadharUrl == null || data.aadharUrl is string) &&
             (data.aadharPublicId == null || data.aadharPublicId is string) &&
             (data.aadharFileName == null || data.aadharFileName is string) &&
             (data.aadharFileType == null || data.aadharFileType is string) &&
             (data.aadharFileSize == null || data.aadharFileSize is number) &&
             // Timestamp fields
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is timestamp) &&
             (data.createdBy == null || data.createdBy is string) &&
             (data.status == null || data.status is string);
    }
    
    // Function to validate HPL club data structure
    function isValidHplClubData(data) {
      return data.keys().hasAll(['proposedClubName', 'primaryOwnerName', 'clubNamingFormat', 'phoneNumber', 'emailId', 'password']) &&
             data.proposedClubName is string &&
             data.primaryOwnerName is string &&
             data.clubNamingFormat is string &&
             data.clubNamingFormat in ['PC', 'PBC', 'Athletic', 'Academy', 'Collective', 'Crew', 'Union', 'Social'] &&
             data.phoneNumber is string &&
             data.emailId is string &&
             data.password is string &&
             // Optional fields
             (data.clubDescription == null || data.clubDescription is string) &&
             (data.communityExistence == null || data.communityExistence is string) &&
             (data.whyJoinLeague == null || data.whyJoinLeague is string) &&
             (data.winningVsCulture == null || data.winningVsCulture is string) &&
             (data.clubFeeling == null || data.clubFeeling is string) &&
             (data.venueAccess == null || data.venueAccess is string) &&
             (data.venueName == null || data.venueName is string) &&
             (data.communityManagerName == null || data.communityManagerName is string) &&
             (data.managerPhoneNumber == null || data.managerPhoneNumber is string) &&
             (data.managerEmailId == null || data.managerEmailId is string) &&
             (data.playerSelectionCriteria == null || data.playerSelectionCriteria is list) &&
             (data.clubUSP == null || data.clubUSP is string) &&
             (data.longTermGoals == null || data.longTermGoals is list) &&
             (data.playerBenefits == null || data.playerBenefits is list) &&
             (data.otherBenefits == null || data.otherBenefits is string) &&
             (data.uniqueCulture == null || data.uniqueCulture is string) &&
             (data.rolesResponsibilities == null || data.rolesResponsibilities is string) &&
             (data.additionalInfo == null || data.additionalInfo is string) &&
             (data.finalDeclarations == null || data.finalDeclarations is list) &&
             // Owner images and names fields
             (data.ownerImages == null || (data.ownerImages is list &&
               data.ownerImages.size() <= 10 && // Limit to 10 owner images
               (data.ownerImages.size() == 0 ||
                 (data.ownerImages[0] is map &&
                  (data.ownerImages[0].url == null || data.ownerImages[0].url is string) &&
                  (data.ownerImages[0].publicId == null || data.ownerImages[0].publicId is string))))) &&
             (data.ownerNames == null || data.ownerNames is string) &&
             // Payment info fields
             (data.paymentInfo == null || data.paymentInfo is map) &&
             // Design Assets fields
             (data.teamLogo == null || (data.teamLogo is map &&
              (data.teamLogo.url == null || data.teamLogo.url is string) &&
              (data.teamLogo.publicId == null || data.teamLogo.publicId is string) &&
              (data.teamLogo.uploadedAt == null || data.teamLogo.uploadedAt is timestamp))) &&
             (data.jerseyDesign == null || (data.jerseyDesign is map &&
              (data.jerseyDesign.url == null || data.jerseyDesign.url is string) &&
              (data.jerseyDesign.publicId == null || data.jerseyDesign.publicId is string) &&
              (data.jerseyDesign.uploadedAt == null || data.jerseyDesign.uploadedAt is timestamp))) &&
             (data.backgroundImage == null || (data.backgroundImage is map &&
              (data.backgroundImage.url == null || data.backgroundImage.url is string) &&
              (data.backgroundImage.publicId == null || data.backgroundImage.publicId is string) &&
              (data.backgroundImage.uploadedAt == null || data.backgroundImage.uploadedAt is timestamp))) &&
             // Timestamp fields
             (data.submittedAt == null || data.submittedAt is timestamp) &&
             (data.status == null || data.status is string);
    }
    
    // Function to validate news data structure
    function isValidNewsData(data) {
      return data.keys().hasAll(['title', 'subtext', 'publishDate']) &&
             data.title is string &&
             data.subtext is string &&
             data.publishDate is timestamp &&
             (data.description == null || data.description is string) &&
             (data.featuredImage == null ||
              data.featuredImage is string ||
              (data.featuredImage is map &&
               (('url' in data.featuredImage && data.featuredImage.url is string) ||
                ('secure_url' in data.featuredImage && data.featuredImage.secure_url is string)) &&
               (!('public_id' in data.featuredImage) || data.featuredImage.public_id is string))) &&
             (data.featured == null || data.featured is bool) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }
    
    // Function to validate featured video data structure
    function isValidFeaturedVideoData(data) {
      return data.keys().hasAll(['title', 'youtubeUrl', 'videoId']) &&
             data.title is string &&
             data.youtubeUrl is string &&
             data.videoId is string &&
             (data.description == null || data.description is string) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }
    
    // Function to validate venue data structure
    function isValidVenueData(data) {
      return data.keys().hasAll(['name', 'createdBy']) &&
             data.name is string &&
             data.createdBy is string &&
             (data.createdAt == null || data.createdAt is timestamp);
    }
    
    // Function to validate tournament data structure
    function isValidTournamentData(data) {
      return data.keys().hasAll(['name', 'description', 'rules', 'prizeMoney', 'startDate', 'endDate', 'categories', 'createdBy']) &&
             data.name is string &&
             data.description is string &&
             data.rules is string &&
             data.prizeMoney is number &&
             data.startDate is timestamp &&
             data.endDate is timestamp &&
             data.categories is map &&
             data.categories.keys().hasAll(['mensSingles', 'mensDoubles', 'womensSingles', 'womensDoubles', 'mixedDoubles']) &&
             data.categories.mensSingles is bool &&
             data.categories.mensDoubles is bool &&
             data.categories.womensSingles is bool &&
             data.categories.womensDoubles is bool &&
             data.categories.mixedDoubles is bool &&
             data.createdBy is string;
    }
    
    // Function to validate player data structure
    function isValidPlayerData(data) {
      return data.keys().hasAll(['name', 'tournamentId', 'createdBy']) &&
             data.name is string &&
             data.tournamentId is string &&
             data.createdBy is string &&
             (data.age == null || data.age is number) &&
             (data.gender == null || data.gender is string) &&
             (data.duprId == null || data.duprId is string) &&
             (data.photo == null ||
              data.photo is string || // Allow direct URL strings for bulk upload
              (data.photo is map &&
               data.photo.keys().hasAll(['url']) &&
               data.photo.url is string &&
               (data.photo.publicId == null || data.photo.publicId is string))) &&
             (data.playerPortrait == null ||
              (data.playerPortrait is map &&
               data.playerPortrait.keys().hasAll(['url']) &&
               data.playerPortrait.url is string &&
               (data.playerPortrait.publicId == null || data.playerPortrait.publicId is string))) &&
             // Backward compatibility photo fields
             (data.photoUrl == null || data.photoUrl is string) &&
             (data.photoPublicId == null || data.photoPublicId is string) &&
             // New rating and statistics fields
             (data.doublesRating == null || data.doublesRating is number) &&
             (data.doublesWins == null || data.doublesWins is number) &&
             (data.doublesLosses == null || data.doublesLosses is number) &&
             (data.singlesRating == null || data.singlesRating is number) &&
             (data.singlesWins == null || data.singlesWins is number) &&
             (data.singlesLosses == null || data.singlesLosses is number) &&
             // Allow createdAt and updatedAt timestamp fields
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
   }
   
   // Function to validate player data structure for updates (more flexible)
   function isValidPlayerUpdateData(data) {
     return data.keys().hasAll(['name', 'tournamentId', 'createdBy']) &&
            data.name is string &&
            data.tournamentId is string &&
            data.createdBy is string &&
            (data.age == null || data.age is number) &&
            (data.gender == null || data.gender is string) &&
            (data.duprId == null || data.duprId is string) &&
            (data.photo == null ||
             data.photo is string || // Allow direct URL strings for bulk upload
             (data.photo is map &&
              data.photo.keys().hasAll(['url']) &&
              data.photo.url is string &&
              (data.photo.publicId == null || data.photo.publicId is string))) &&
            (data.playerPortrait == null ||
             (data.playerPortrait is map &&
              data.playerPortrait.keys().hasAll(['url']) &&
              data.playerPortrait.url is string &&
              (data.playerPortrait.publicId == null || data.playerPortrait.publicId is string))) &&
            // Backward compatibility photo fields
            (data.photoUrl == null || data.photoUrl is string) &&
            (data.photoPublicId == null || data.photoPublicId is string) &&
            // New rating and statistics fields
            (data.doublesRating == null || data.doublesRating is number) &&
            (data.doublesWins == null || data.doublesWins is number) &&
            (data.doublesLosses == null || data.doublesLosses is number) &&
            (data.singlesRating == null || data.singlesRating is number) &&
            (data.singlesWins == null || data.singlesWins is number) &&
            (data.singlesLosses == null || data.singlesLosses is number) &&
            // Allow updatedAt timestamp for updates
            (data.updatedAt == null || data.updatedAt is timestamp);
   }
    
    // Function to validate team data structure
    function isValidTeamData(data) {
      return data.keys().hasAll(['name', 'playerIds', 'tournamentId', 'createdBy']) &&
             data.name is string &&
             data.playerIds is list &&
             data.playerIds.size() >= 0 && // Allow empty lists for bulk import
             data.tournamentId is string &&
             data.createdBy is string &&
             (data.description == null || data.description is string) &&
             (data.adminEmail == null || data.adminEmail is string) &&
             (data.adminUid == null || data.adminUid is string) &&
             (data.logo == null || (data.logo is map &&
              (data.logo.url == null || data.logo.url is string) &&
              (data.logo.publicId == null || data.logo.publicId is string))) &&
             (data.playerImages == null || (data.playerImages is list &&
              data.playerImages.size() >= 0 &&
              data.playerImages.size() <= 20 && // Reasonable limit for player images
              (data.playerImages.size() == 0 ||
               (data.playerImages[0].keys().hasAny(['url', 'publicId']) &&
                (data.playerImages[0].url == null || data.playerImages[0].url is string) &&
                (data.playerImages[0].publicId == null || data.playerImages[0].publicId is string))))) &&
             (data.venue == null || data.venue is string) &&
             (data.venueId == null || data.venueId is string) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }
    
    // Enhanced function to check if current user is super admin
    function isSuperAdminSimple() {
      // Check hardcoded super admin email for backward compatibility OR database role
      return request.auth != null &&
             (request.auth.token.email == 'siddharth@318digital.com' ||
              isSuperAdminFromDatabase());
    }
    
    // Function to check if user has super_admin role in database
    function isSuperAdminFromDatabase() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    // Function to validate user data structure for super admin creation
    function isValidUserData(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role is string &&
             data.role in ['super_admin', 'team_admin'] &&
             (data.displayName == null || data.displayName is string) &&
             (data.photoURL == null || data.photoURL is string) &&
             (data.teamName == null || data.teamName is string) &&
             (data.tournamentId == null || data.tournamentId is string) &&
             (data.tempPassword == null || data.tempPassword is string) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is timestamp) &&
             (data.createdBy == null || data.createdBy is string);
    }
    
    // Function to validate display setting data structure
    function isValidDisplaySettingData(data) {
      return data.keys().hasAll(['tournamentId', 'date', 'currentFixture']) &&
             data.tournamentId is string &&
             data.date is string &&
             data.currentFixture is map &&
             data.currentFixture.keys().hasAll(['fixtureGroupId', 'team1Name', 'team2Name']) &&
             data.currentFixture.fixtureGroupId is string &&
             data.currentFixture.team1Name is string &&
             data.currentFixture.team2Name is string &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }
    
    // Function to validate video links data structure (now supports mixed media)
    function isValidVideoLinksData(data) {
      return data.keys().hasAll(['tournamentId']) &&
             data.tournamentId is string &&
             // Support both old format (links) and new format (mediaItems)
             (('links' in data && data.links is list && isValidVideoLinksArray(data.links)) ||
              ('mediaItems' in data && data.mediaItems is list && isValidMediaItemsArray(data.mediaItems)) ||
              ('links' in data && 'mediaItems' in data &&
               data.links is list && data.mediaItems is list &&
               isValidVideoLinksArray(data.links) && isValidMediaItemsArray(data.mediaItems))) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }
    
    // Function to validate individual video link objects in the array (backward compatibility)
    function isValidVideoLinksArray(links) {
      return links.size() >= 0 &&
             links.size() <= 50; // Reasonable limit - simplified validation
    }
    
    // Function to validate individual media item objects in the array (new format)
    function isValidMediaItemsArray(mediaItems) {
      return mediaItems.size() >= 0 &&
             mediaItems.size() <= 50 && // Reasonable limit
             // Simplified validation - each item should have basic required fields
             (mediaItems.size() == 0 ||
              (mediaItems[0].keys().hasAny(['id', 'type', 'url', 'title', 'rank']) &&
               (mediaItems[0].type == null || mediaItems[0].type in ['video', 'image']) &&
               (mediaItems[0].url == null || mediaItems[0].url is string) &&
               (mediaItems[0].title == null || mediaItems[0].title is string) &&
               (mediaItems[0].rank == null || mediaItems[0].rank is number)));
  }
  
  // Function to validate tournament logos data structure
  function isValidTournamentLogosData(data) {
    return data.keys().hasAll(['tournamentId', 'displayLogos']) &&
           data.tournamentId is string &&
           data.displayLogos is list &&
           data.displayLogos.size() >= 0 &&
           data.displayLogos.size() <= 20 && // Reasonable limit for logos
           (data.updatedAt == null || data.updatedAt is timestamp) &&
           // Simplified validation for logo items
           (data.displayLogos.size() == 0 ||
            (data.displayLogos[0].keys().hasAny(['id', 'url', 'title', 'rank']) &&
             (data.displayLogos[0].url == null || data.displayLogos[0].url is string) &&
             (data.displayLogos[0].title == null || data.displayLogos[0].title is string) &&
             (data.displayLogos[0].rank == null || data.displayLogos[0].rank is number) &&
             (data.displayLogos[0].publicId == null || data.displayLogos[0].publicId is string)));
  }
  
  // Function to check if this is a rating-only update (singlesRating, doublesRating, duprId, updatedAt)
   function isRatingUpdate(newData, oldData) {
     return newData.keys().hasAll(['name', 'tournamentId', 'createdBy']) &&
            newData.name == oldData.name &&
            newData.tournamentId == oldData.tournamentId &&
            newData.createdBy == oldData.createdBy &&
            (newData.singlesRating != oldData.singlesRating ||
             newData.doublesRating != oldData.doublesRating ||
             newData.duprId != oldData.duprId);
   }
  
  // Function to check if current user is a team admin for a specific tournament
   function isTeamAdminForPlayer(tournamentId) {
     return request.auth != null &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'team_admin' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tournamentId == tournamentId;
   }
   
   // Function to check if current user is the tournament creator
   function isTournamentCreator(tournamentId) {
     return request.auth != null &&
            exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
            get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid;
   }
   
   // Function to validate ticketing (match day) data structure
   function isValidTicketingData(data) {
     return data.keys().hasAll(['name', 'tournamentId', 'date', 'hostTeam', 'hostTeamId', 'deadline']) &&
            data.name is string &&
            data.tournamentId is string &&
            data.date is string &&
            data.hostTeam is string &&
            data.hostTeamId is string &&
            data.deadline is string &&
            (data.imageUrl == null || data.imageUrl is string) &&
            (data.imagePublicId == null || data.imagePublicId is string) &&
            (data.status == null || data.status is string) &&
            (data.status == null || data.status in ['active', 'completed', 'cancelled']) &&
            (data.totalTickets == null || data.totalTickets is number) &&
            (data.soldTickets == null || data.soldTickets is number) &&
            (data.revenue == null || data.revenue is number) &&
            (data.createdAt == null || data.createdAt is timestamp) &&
            (data.updatedAt == null || data.updatedAt is timestamp);
   }
   
   // Function to validate ticket type data structure
   function isValidTicketTypeData(data) {
     return data.keys().hasAll(['name', 'price', 'quantity']) &&
            data.name is string &&
            data.price is number &&
            data.price >= 0 &&
            data.quantity is number &&
            data.quantity >= 0 &&
            (data.sold == null || data.sold is number) &&
            (data.sold == null || data.sold >= 0) &&
            (data.available == null || data.available is number) &&
            (data.available == null || data.available >= 0) &&
            (data.createdAt == null || data.createdAt is timestamp);
  }
  
  // Function to validate vendor data structure
  function isValidVendorData(data) {
    return data.keys().hasAll(['name', 'email', 'phone', 'category']) &&
           data.name is string &&
           data.email is string &&
           data.phone is string &&
           data.category is string &&
           data.category in ['Food', 'Merchandise', 'Others'] &&
           (data.logo == null || data.logo is string) &&
           (data.status == null || data.status is string) &&
           (data.status == null || data.status in ['pending', 'active', 'inactive']) &&
           (data.passwordSetAt == null || data.passwordSetAt is string) &&
           (data.createdAt == null || data.createdAt is timestamp) &&
           (data.updatedAt == null || data.updatedAt is timestamp);
  }
}
}