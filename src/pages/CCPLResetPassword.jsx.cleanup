import React, { useState, useEffect } from 'react';
import CCPLTopBar from '../components/CCPLTopBar';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { collection, query, where, getDocs, doc, updateDoc } from 'firebase/firestore';
import { db } from '../utils/firebase';
import CryptoJS from 'crypto-js';
import CCPLNavbar from '../components/CCPLNavbar';

const CCPLResetPassword = () => {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [error, setError] = useState('');
  const [success, setSuccess] = useState(false);
  const [loading, setLoading] = useState(false);
  const [validating, setValidating] = useState(true);
  const [tokenValid, setTokenValid] = useState(false);
  const [isMobile, setIsMobile] = useState(false);

  const accentColor = '#ee3a24';
  const accentColorDark = '#7d0f0f';

  const token = searchParams.get('token');
  const email = searchParams.get('email');

  console.log('CCPLResetPassword component loaded');
  console.log('Token:', token);
  console.log('Email:', email);

  useEffect(() => {
    const updateSize = () => {
      setIsMobile(window.innerWidth < 860);
    };
    
    updateSize();
    window.addEventListener('resize', updateSize);
    return () => window.removeEventListener('resize', updateSize);
  }, []);

  useEffect(() => {
    validateToken();
  }, [token, email]);

  const validateToken = async () => {
    if (!token || !email) {
      setError('Invalid reset link. Please request a new password reset.');
      setValidating(false);
      return;
    }

    try {
      // Query ccpl-users collection for the user with this email and reset token
      const usersRef = collection(db, 'ccpl-users');
      const q = query(
        usersRef,
        where('email', '==', email.toLowerCase()),
        where('resetToken', '==', token)
      );
      
      const querySnapshot = await getDocs(q);
      
      if (querySnapshot.empty) {
        setError('Invalid or expired reset link. Please request a new password reset.');
        setValidating(false);
        return;
      }

      const userDoc = querySnapshot.docs[0];
      const userData = userDoc.data();

      // Check if token has expired (1 hour expiry)
      if (userData.resetTokenExpiry) {
        const expiryTime = userData.resetTokenExpiry.toDate();
        const now = new Date();
        
        if (now > expiryTime) {
          setError('This reset link has expired. Please request a new password reset.');
          setValidating(false);
          return;
        }
      }

      setTokenValid(true);
      setValidating(false);
    } catch (err) {
      console.error('Token validation error:', err);
      setError('An error occurred. Please try again.');
      setValidating(false);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    
    if (!password.trim() || !confirmPassword.trim()) {
      setError('Please enter and confirm your new password.');
      return;
    }

    if (password.length < 6) {
      setError('Password must be at least 6 characters long.');
      return;
    }

    if (password !== confirmPassword) {
      setError('Passwords do not match.');
      return;
    }

    setLoading(true);
    setError('');

    try {
      // Find the user document
      const usersRef = collection(db, 'ccpl-users');
      const q = query(
        usersRef,
        where('email', '==', email.toLowerCase()),
        where('resetToken', '==', token)
      );
      
      const querySnapshot = await getDocs(q);
      
      if (querySnapshot.empty) {
        setError('Invalid reset link. Please try again.');
        setLoading(false);
        return;
      }

      const userDoc = querySnapshot.docs[0];
      const userDocRef = doc(db, 'ccpl-users', userDoc.id);

      // Hash the new password
      const hashedPassword = CryptoJS.SHA256(password).toString();

      // Update the password and remove reset token
      await updateDoc(userDocRef, {
        password: hashedPassword,
        resetToken: null,
        resetTokenExpiry: null,
        updatedAt: new Date()
      });

      setSuccess(true);
      setLoading(false);

      // Redirect to login after 3 seconds
      setTimeout(() => {
        navigate('/ccpl-login');
      }, 3000);

    } catch (err) {
      console.error('Password reset error:', err);
      setError('An error occurred while resetting your password. Please try again.');
      setLoading(false);
    }
  };


  return (
    <div style={{ fontFamily: "'Montserrat', sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');
        
        @font-face {
          font-family: 'Zuume Cut';
          src: url('/fonts/zuume-cut-black.ttf') format('truetype');
          font-weight: 900;
          font-style: normal;
        }
        @font-face {
          font-family: 'Zuume Cut';
          src: url('/fonts/zuume-cut-black-italic.ttf') format('truetype');
          font-weight: 900;
          font-style: italic;
        }
        
        body {
          margin: 0;
          background: #0b0b0c;
        }
        
        a {
          color: ${accentColor};
        }
        
        a:hover {
          color: #ffffff;
        }
        
        input::placeholder {
          color: rgba(255, 255, 255, 0.35);
        }
        
        ::selection {
          background: ${accentColor};
          color: #0b0b0c;
        }
        
        .zuume-heading {
          font-family: 'Zuume Cut', sans-serif;
          font-weight: 900;
          font-style: italic;
        }
        
        .zuume-normal {
          font-family: 'Zuume Cut', sans-serif;
          font-weight: 900;
          font-style: normal;
        }
        
        .ccpl-top-bar::-webkit-scrollbar {
          display: none;
        }
        .ccpl-top-bar {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
        
        .cc-league-tab {
          transition: background 0.2s ease, color 0.2s ease;
        }
        
        .cc-league-tab:hover {
          background: rgba(255, 255, 255, 0.85) !important;
        }
        
        .cc-social {
          transition: background 0.2s ease;
        }
        
        .cc-social:hover {
          background: #232324 !important;
        }
      `}</style>

        <CCPLTopBar activeLeague="ccpl-s2" accentColor={accentColor} />
        <div style={{ flex: 1, minWidth: '0' }}></div>
        <div style={{ display: 'flex', alignItems: 'stretch', flexShrink: 0, minWidth: 'min-content' }}>
          <a href="#" className="cc-social" aria-label="Instagram" style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', width: '50px', background: '#0b0b0c', color: '#fff', textDecoration: 'none' }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="#" className="cc-social" aria-label="YouTube" style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', width: '50px', background: '#0b0b0c', color: '#fff', textDecoration: 'none' }}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21.6 7.2c-.25-1-1-1.75-2-2C17.9 4.8 12 4.8 12 4.8s-5.9 0-7.6.4c-1 .25-1.75 1-2 2C2 8.9 2 12 2 12s0 3.1.4 4.8c.25 1 1 1.75 2 2 1.7.4 7.6.4 7.6.4s5.9 0 7.6-.4c1-.25 1.75-1 2-2 .4-1.7.4-4.8.4-4.8s0-3.1-.4-4.8zM10 15.2V8.8l6 3.2-6 3.2z"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Navigation */}
      <CCPLNavbar activePage="login" />

      <section style={{
        position: 'relative',
        background: '#0b0b0c',
        color: '#fff',
        fontFamily: "'Montserrat', sans-serif",
        minHeight: 'calc(100vh - 196px)',
        boxSizing: 'border-box',
        padding: '64px 6vw 96px',
        display: 'flex',
        justifyContent: 'center'
      }}>
        <div style={{ maxWidth: '460px', width: '100%' }}>
          
          {/* Header Badge */}
          <div style={{
            display: 'flex',
            alignItems: 'center',
            gap: '10px',
            marginBottom: '28px'
          }}>
            <div style={{
              width: '6px',
              height: '6px',
              borderRadius: '50%',
              background: accentColor
            }}></div>
            <span style={{
              fontSize: '11px',
              letterSpacing: '0.2em',
              textTransform: 'uppercase',
              color: 'rgba(255, 255, 255, 0.5)'
            }}>Season 2 · Password Reset</span>
          </div>

          {/* Title */}
          <h1 className="zuume-heading" style={{
            fontSize: 'clamp(38px, 5vw, 56px)',
            lineHeight: '0.9',
            margin: '0 0 10px',
            textTransform: 'uppercase'
          }}>
            Reset Password.
          </h1>
          <p style={{
            margin: '0 0 32px',
            fontSize: '14px',
            lineHeight: '1.6',
            color: 'rgba(255, 255, 255, 0.5)',
            maxWidth: '380px'
          }}>
            Enter your new password below to regain access to your account.
          </p>

          {/* Validating State */}
          {validating && (
            <div style={{
              border: '1px solid rgba(255, 255, 255, 0.18)',
              padding: '40px 32px',
              textAlign: 'center'
            }}>
              <p style={{
                fontSize: '14px',
                color: 'rgba(255, 255, 255, 0.55)',
                margin: '0'
              }}>
                Validating reset link...
              </p>
            </div>
          )}

          {/* Success State */}
          {success && (
            <div style={{
              border: '1px solid rgba(255, 255, 255, 0.18)',
              padding: '40px 32px',
              display: 'flex',
              flexDirection: 'column',
              gap: '14px'
            }}>
              <span style={{
                fontSize: '12px',
                letterSpacing: '0.2em',
                textTransform: 'uppercase',
                color: '#4ade80'
              }}>
                Success
              </span>
              <p className="zuume-normal" style={{
                fontSize: '32px',
                lineHeight: '1',
                margin: '0',
                textTransform: 'uppercase'
              }}>
                Password Reset!
              </p>
              <p style={{
                fontSize: '13.5px',
                lineHeight: '1.6',
                color: 'rgba(255, 255, 255, 0.55)',
                margin: '0'
              }}>
                Your password has been successfully reset. Redirecting you to login...
              </p>
            </div>
          )}

          {/* Reset Form */}
          {!validating && !success && tokenValid && (
            <form onSubmit={handleSubmit} style={{
              display: 'flex',
              flexDirection: 'column',
              gap: '22px'
            }}>
              {/* New Password Field */}
              <label style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '8px',
                fontSize: '11px',
                letterSpacing: '0.14em',
                textTransform: 'uppercase',
                color: 'rgba(255, 255, 255, 0.5)'
              }}>
                New Password
                <input
                  required
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••"
                  style={{
                    background: 'transparent',
                    border: 'none',
                    borderBottom: '1px solid rgba(255, 255, 255, 0.25)',
                    color: '#fff',
                    fontFamily: "'Montserrat', sans-serif",
                    fontSize: '16px',
                    padding: '10px 2px',
                    outline: 'none'
                  }}
                />
              </label>

              {/* Confirm Password Field */}
              <label style={{
                display: 'flex',
                flexDirection: 'column',
                gap: '8px',
                fontSize: '11px',
                letterSpacing: '0.14em',
                textTransform: 'uppercase',
                color: 'rgba(255, 255, 255, 0.5)'
              }}>
                Confirm New Password
                <input
                  required
                  type="password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  placeholder="••••••••"
                  style={{
                    background: 'transparent',
                    border: 'none',
                    borderBottom: '1px solid rgba(255, 255, 255, 0.25)',
                    color: '#fff',
                    fontFamily: "'Montserrat', sans-serif",
                    fontSize: '16px',
                    padding: '10px 2px',
                    outline: 'none'
                  }}
                />
              </label>

              {/* Error Message */}
              {error && (
                <p style={{
                  margin: '0',
                  fontSize: '12.5px',
                  color: accentColor
                }}>
                  {error}
                </p>
              )}

              {/* Submit Button */}
              <button
                type="submit"
                disabled={loading}
                style={{
                  padding: '19px',
                  background: loading ? '#666' : `linear-gradient(180deg, ${accentColor}, ${accentColorDark})`,
                  border: 'none',
                  color: '#fff',
                  fontFamily: "'Montserrat', sans-serif",
                  fontWeight: 700,
                  fontSize: '15px',
                  letterSpacing: '0.08em',
                  textTransform: 'uppercase',
                  cursor: loading ? 'not-allowed' : 'pointer',
                  opacity: loading ? 0.7 : 1
                }}
              >
                {loading ? 'Resetting Password...' : 'Reset Password →'}
              </button>
            </form>
          )}

          {/* Error State */}
          {!validating && !tokenValid && (
            <div style={{
              border: '1px solid rgba(255, 255, 255, 0.18)',
              padding: '40px 32px',
              display: 'flex',
              flexDirection: 'column',
              gap: '14px'
            }}>
              <p style={{
                fontSize: '13.5px',
                lineHeight: '1.6',
                color: accentColor,
                margin: '0'
              }}>
                {error}
              </p>
              <a
                href="/ccpl-login"
                style={{
                  marginTop: '8px',
                  fontSize: '12px',
                  letterSpacing: '0.12em',
                  textTransform: 'uppercase',
                  textDecoration: 'underline'
                }}
              >
                Back to Login
              </a>
            </div>
          )}
        </div>
      </section>
    </div>
  );
};

export default CCPLResetPassword;
